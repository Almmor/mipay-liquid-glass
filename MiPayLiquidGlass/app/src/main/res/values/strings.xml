<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">小米智能卡 · 液态玻璃</string>
    <string name="xposed_description">为小米智能卡 / 小米钱包的刷卡与支付页面注入液态玻璃（Liquid Glass）材质：窗口背景模糊、玻璃卡片、折射色散高光与边缘柔光，并完整保留设备卡面。</string>

    <string name="header_title">液态玻璃</string>
    <string name="header_subtitle">Mi Pay Liquid Glass · 刷卡页面视觉增强</string>
    <string name="badge">LSPosed 模块 · 需在管理器中勾选「小米智能卡」</string>

    <string name="panel_material">玻璃材质</string>
    <string name="panel_advanced">高级渲染</string>
    <string name="panel_cardface">卡面保护</string>
    <string name="panel_root">Root 操作</string>
    <string name="panel_preview">效果预览</string>

    <string name="opt_enable">启用液态玻璃</string>
    <string name="opt_enable_desc">总开关，关闭后立即恢复系统原样</string>
    <string name="opt_blur">背景模糊半径</string>
    <string name="opt_tint">玻璃染色强度</string>
    <string name="opt_corner">玻璃圆角半径</string>

    <string name="opt_refraction">折射与色散高光</string>
    <string name="opt_refraction_desc">AGSL 着色器绘制玻璃边缘折射与彩虹色散（需 Android 13+）</string>
    <string name="opt_flow">流光动效</string>
    <string name="opt_flow_desc">玻璃表面缓慢流动的镜面高光（会增加少量耗电）</string>
    <string name="opt_deep">深度美化</string>
    <string name="opt_deep_desc">将纯色背景的容器也转换为玻璃材质</string>
    <string name="opt_immersive">沉浸模式</string>
    <string name="opt_immersive_desc">让应用根背景半透明，透出被模糊的桌面 / 上层内容</string>

    <string name="opt_keep_face">保留设备卡面</string>
    <string name="opt_keep_face_desc">识别为卡面 / 图片素材的视图（ImageView、Bitmap 背景、自定义 Drawable、资源名含 card 等）完全不作修改</string>
    <string name="opt_smart_targets">精准适配小米智能卡</string>
    <string name="opt_smart_targets_desc">按反编译得到的类名白名单直接命中刷卡页与卡面下方的自绘控件（CardStackLayout、SwitchCardFingerLayer、MiPayCardItemView 等）。关闭后刷卡页几乎不会有任何效果</string>
    <string name="opt_overlay">卡面叠加玻璃镜面</string>
    <string name="opt_overlay_desc">在保留的卡面之上叠一层折射高光与流光，卡面图案依然清晰可见</string>
    <string name="opt_rim_stroke">玻璃边缘亮线</string>
    <string name="opt_rim_stroke_desc">给每块玻璃描一圈白色亮边。默认关闭 —— 页面元素多时，大量亮边叠加会形成满屏线条</string>
    <string name="opt_card_radius">卡面圆角</string>
    <string name="opt_card_radius_desc">卡面玻璃罩的圆角，按屏幕物理尺寸换算。规格为 3.18mm（1/8 英寸）时与卡面严丝合缝</string>
    <string name="opt_island">iOS 超级岛样式</string>
    <string name="opt_island_desc">把刷卡「超级岛」（HyperOS 焦点通知）改写为 iOS 灵动岛观感：标题转白、副标题 60% 白、隐藏右侧图标与按钮</string>
    <string name="opt_island_anim">iOS 刷卡动画</string>
    <string name="opt_island_anim_desc">刷卡时播放 iOS 风格动画：从屏幕顶部探出（探出同时卡片即翻转）→ 白色对勾/叉描线 → 交易金额与余额 → 缩回顶部。正面绘制真实卡面、背面为纯黑卡，由 SystemUI 自绘，锁屏同样可见</string>
    <string name="opt_island_overlay">iOS 刷卡动画（SystemUI）</string>
    <string name="opt_island_overlay_desc">由 SystemUI 用系统窗口自绘高保真动画，能盖在锁屏之上。需要在 LSPosed 中把「系统界面」也加入本模块作用域</string>
    <string name="btn_preview_island_ok">预览成功动画（App 内）</string>
    <string name="btn_preview_island_fail">预览失败动画（App 内）</string>
    <string name="btn_preview_island_sysui">模拟刷卡成功（SystemUI 岛）</string>
    <string name="btn_preview_island_sysui_fail">模拟刷卡失败（SystemUI 岛）</string>
    <string name="preview_island_sent">已发送「刷卡成功」给 SystemUI。若顶部没有出现动画：请到「LSPosed 管理器 → 本模块 → 作用域」勾选「系统界面」，再点「重启 SystemUI」；并确认屏幕已点亮</string>
    <string name="preview_island_sent_fail">已发送「刷卡失败」给 SystemUI。若顶部没有出现动画，请先确认屏幕已点亮，并检查 SystemUI 作用域是否已勾选</string>
    <string name="island_scope_hint">⚠️ 刷卡动画由 SystemUI 绘制，必须在 LSPosed 作用域里勾选「系统界面（com.android.systemui）」，否则点了预览也不会有任何反应。测试时请先点亮屏幕（锁屏界面同样可以看到动画）。\n\n⚠️ 动画代码跑在 SystemUI 进程里，而 SystemUI 常年不重启：装完新版本 APK 后，请点上面的「重启 SystemUI」让新代码生效，否则你看到的仍是旧动画。</string>
    <string name="opt_hide_system_island">隐藏系统岛动画</string>
    <string name="opt_hide_system_island_desc">按前缀摘掉焦点通知的全部岛参数（miui.focus.* 与 param_island），系统不再播它自己的超级岛，只保留我们的 iOS 动画。默认开启；若关闭会同时出现两套岛</string>

    <string name="btn_pick_face">选择卡面</string>
    <string name="opt_pick_face_desc">点上面的按钮会列出已识别到的卡面，直接看图选择动画要显示哪一张。卡名与图片来自小米智能卡自己的卡片列表，需要先在小米智能卡里看到过卡片列表。</string>
    <string name="pick_face_title">选择动画显示的卡面</string>
    <string name="pick_face_button">选择卡面（当前：%1$s）</string>
    <string name="pick_face_auto">自动（跟随主卡）</string>
    <string name="pick_face_current">当前卡面：%1$s</string>
    <string name="pick_face_summary">已识别到 %1$d 张卡面，点上面的按钮可看图选择</string>
    <string name="pick_face_none">还没识别到任何卡面。请先打开小米智能卡、看到卡片列表，再回来点这个按钮。</string>
    <string name="pick_face_found">已识别到 %1$d 张卡面</string>
    <string name="pick_face_querying">正在向小米智能卡查询已识别的卡片…若一直没有结果，请先打开一次小米智能卡</string>
    <string name="pick_face_requesting">正在向小米智能卡查询已识别的卡片…</string>

    <string name="root_hint">修改配置后，目标应用需要重新启动才会加载新设置。这里用 Root 权限强制停止并重新打开小米智能卡，比手动去系统设置里操作更省事。</string>
