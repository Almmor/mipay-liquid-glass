<?xml version="1.0" encoding="utf-8"?>
<!--
  排版规范取自 Miuix（compose-miuix-ui/miuix）的 Text Styles：
  https://compose-miuix-ui.github.io/miuix/guide/textstyles
  main 17sp / body2 14sp / footnote1 13sp / footnote2 11sp / subtitle 14sp Bold / title2 24sp，
  权重统一 Normal（Miuix 不用粗体做层级，靠字号与颜色区分）。
-->
<resources>

    <style name="Theme.LiquidGlass" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/miuix_surface</item>
        <item name="android:colorAccent">@color/miuix_primary</item>
        <item name="android:colorControlActivated">@color/miuix_primary</item>
        <item name="android:colorControlHighlight">@color/miuix_control_highlight</item>
        <item name="android:colorControlNormal">@color/miuix_on_surface_container_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 分组小标题（Miuix 设置页的分组标签） -->
    <style name="PanelTitle">
        <item name="android:textColor">@color/miuix_on_surface_container_variant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- 行标题：Miuix main 17sp -->
    <style name="OptionTitle">
        <item name="android:textColor">@color/miuix_on_surface_container</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- 行摘要：Miuix footnote1 13sp -->
    <style name="OptionDesc">
        <item name="android:textColor">@color/miuix_on_surface_container_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- 主按钮：Miuix primary -->
    <style name="MiuixButtonPrimary">
        <item name="android:textColor">@color/miuix_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <!-- 次按钮：Miuix secondaryContainer -->
    <style name="MiuixButtonSecondary">
        <item name="android:textColor">@color/miuix_on_secondary_variant</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
    </style>

    <!-- 页面大标题：Miuix title2 24sp -->
    <style name="MiuixPageTitle">
        <item name="android:textColor">@color/miuix_on_surface_container</item>
        <item name="android:textSize">24sp</item>
    </style>

</resources>
