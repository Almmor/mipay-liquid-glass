<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 风格刷卡动画的岛内容布局（1.3.0）。

  结构自上而下（与 iOS Apple Pay 动画一致）：
    ① 卡片（ViewFlipper 承载，翻转前后两帧）
    ② 交易状态图标（打勾 / 打叉）
    ③ 交易金额
    ④ 余额

  注意：本布局会被 RemoteViews 在 SystemUI 进程里 inflate，
  因此只能使用 RemoteViews 白名单内的控件
  （LinearLayout / FrameLayout / RelativeLayout / ViewFlipper / ImageView / TextView 等）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_island_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <!-- ① 卡片：两帧相同卡面，靠 in/out 动画做出翻转观感 -->
    <ViewFlipper
        android:id="@+id/island_card_flipper"
        android:layout_width="152dp"
        android:layout_height="96dp"
        android:inAnimation="@anim/island_flip_in"
        android:outAnimation="@anim/island_flip_out">

        <ImageView
            android:id="@+id/island_card_front"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/island_card_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </ViewFlipper>

    <!-- ② 交易状态：打勾 / 打叉 -->
    <ImageView
        android:id="@+id/island_status"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- ③ 交易金额 -->
    <TextView
        android:id="@+id/island_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ④ 余额 -->
    <TextView
        android:id="@+id/island_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#99FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
